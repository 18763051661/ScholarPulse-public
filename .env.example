# ====== LLM 配置（支持任意 OpenAI 兼容接口：OpenAI / DeepSeek / Moonshot / Qwen / 本地 vLLM） ======
# 留空则自动进入 DEMO 模式（用内置规则引擎模拟智能体输出，无需联网即可跑通全流程）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ====== 系统参数 ======
# 每轮学习循环最多推送给学生的题目数
MAX_QUIZ_PER_ROUND=4
# 掌握度低于此值视为"薄弱"
WEAK_THRESHOLD=0.6
# 学习循环最多轮次（防止死循环）
MAX_LOOP_ROUNDS=3
# 两次报表间隔天数（业务上是 15 天，demo 可配短）
REPORT_INTERVAL_DAYS=15

# ====== 多供应商故障转移（LLM 四级链路） ======
SILICONFLOW_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# ====== RAG 语义嵌入（硅基流动 Embedding，第三检索通道，失败自动降级离线） ======
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_EMBED_TIMEOUT_MS=6000
